      "allowed_values": [
        "cpm",
        "cpp_style",
        "custom_issues",
        "docker",
        "docs",
        "flathub",
        "homebrew",
        "node_ci",
        "npm",
        "pacman",
        "python_style",
        "release_notifications",
        "winget"
      ],
      "values_editable_by": "org_actors",
      "require_explicit_values": false
    }
  ]
