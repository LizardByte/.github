{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Flatpak sources annotated with x-renovate",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["packaging/linux/flatpak/modules/**/*.json"],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        // Read metadata and require a ref for commit-only checkouts.
        '"x-renovate"\\s*:\\s*\\{\\s*"datasource"\\s*:\\s*"(?<datasource>[a-z0-9_.-]+)"\\s*,\\s*"depName"\\s*:\\s*"(?<depName>[^"]+)"(?:\\s*,\\s*"packageName"\\s*:\\s*"(?<packageName>[^"]+)")?(?:\\s*,\\s*"versioning"\\s*:\\s*"(?<versioning>[^"]+)")?(?:\\s*,\\s*"ref"\\s*:\\s*"(?<metadataRef>[^"]+)"\\s*\\}\\s*,\\s*"url"\\s*:\\s*"[^"]+"\\s*,\\s*"commit"\\s*:\\s*"[a-fA-F0-9]{40}"|\\s*\\}\\s*,\\s*"url"\\s*:\\s*"[^"]+"\\s*,\\s*"(?:tag|branch|sha256)"\\s*:\\s*"[^"]+"(?:\\s*,\\s*"commit"\\s*:\\s*"[^"]+")?)',
        // Limit replacements to the source URL and its pin fields.
        '"url"\\s*:\\s*"(?:(?:https://github[.]com/[^/"]+/[^/"]+/releases/download/(?<archiveTag>[^/"]+)/[^"]+)"\\s*,\\s*"sha256"|(?<gitUrl>[^"]+)"\\s*,\\s*(?:"(?:tag|branch)"\\s*:\\s*"(?<gitRef>[^"]+)"\\s*,\\s*)?"commit")\\s*:\\s*"(?<currentDigest>[a-fA-F0-9]{40}(?:[a-fA-F0-9]{24})?)"',
      ],
      "packageNameTemplate": "{{#if packageName}}{{{packageName}}}{{else if metadataRef}}{{{gitUrl}}}{{else}}{{{depName}}}{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{replace '(\\x5c){2}' '$1' versioning}}}{{else if metadataRef}}exact{{/if}}",
      "currentValueTemplate": "{{#if gitRef}}{{{gitRef}}}{{else if metadataRef}}{{{metadataRef}}}{{else}}{{{archiveTag}}}{{/if}}",
    },
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["packaging/linux/flatpak/modules/**/*.json"],
      "matchDatasources": ["github-release-attachments"],
      // The datasource can return the old checksum if it cannot identify the pinned asset.
      "matchJsonata": ["newValue != currentValue and newDigest and newDigest = currentDigest"],
      "enabled": false,
    },
  ],
}
