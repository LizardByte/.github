{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "CDN dependency extraction, digest policy, and update schedules",
  "extends": ["github>LizardByte/.github//renovate/jekyll.json5"],
  "cdnurl": {
    "managerFilePatterns": [
      "/(^|/)assets/.*[.]css$/",
    ],
  },
  "packageRules": [
    // Do not open standalone cdnjs SRI digest updates. Version updates still refresh the paired SRI hash.
    {
      "matchDatasources": ["cdnjs"],
      "matchUpdateTypes": ["digest"],
      "enabled": false,
    },
    // Schedule Lucide updates weekly because it releases frequently
    {
      "matchPackageNames": [
        "lucide",
      ],
      "schedule": ["* 1-7 * * 1"],
    },
  ],
  "customManagers": [
    // Versioned npm CDN URLs in selected source/data files without SRI.
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^(?:_includes/.*[.]html|apps/.*[.]json|assets/.*[.]js|dockle[.]toml|docs/source/conf[.]py|jsdoc[.]config[.]js)$/",
      ],
      "matchStrings": [
        "https://(?:cdn\\.jsdelivr\\.net/npm|unpkg\\.com)/(?<depName>(?:@[^@/\"'\\s]+/)?[^@/\"'\\s]+)@(?<currentValue>v?\\d[^/\"'\\s?#]*)",
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm",
    },
  ],
}
