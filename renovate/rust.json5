{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Rust dependency groups",
  "packageRules": [
    // Diesel migrations require a compatible Diesel minor release.
    {
      "groupName": "Diesel",
      "matchManagers": [
        "cargo",
      ],
      "matchPackageNames": [
        "diesel",
        "diesel_migrations",
      ],
      "separateMultipleMajor": false,
    },
  ],
}
