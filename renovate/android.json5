{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Stable Android SDK packages annotated in Gradle properties",
  "customDatasources": {
    "android-sdk-packages": {
      "defaultRegistryUrlTemplate": "https://dl.google.com/android/repository/repository2-3.xml",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\":[$split($join(releases.version, \"\\n\"), \"</remotePackage>\")[$contains($, '<channelRef ref=\"channel-0\"')].$match($, /<remotePackage path=\"{{packageName}};([0-9]+[.][0-9]+[.][0-9]+)\">/).{\"version\":groups[0]}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)gradle\\.properties$/"
      ],
      "matchStrings": [
        "# renovate: android-sdk=(?<depName>build-tools|ndk|cmake)[ \\t]*\\r?\\n[A-Za-z][A-Za-z0-9_.-]*[ \\t]*=[ \\t]*(?<currentValue>\\d+\\.\\d+\\.\\d+)[ \\t]*(?:\\r?\\n|$)"
      ],
      "datasourceTemplate": "custom.android-sdk-packages",
      "packageNameTemplate": "{{{depName}}}",
      "versioningTemplate": "semver"
    }
  ]
}
