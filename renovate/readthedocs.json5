{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Read the Docs supported runtime selectors and build images",
  // Read the Docs publishes the exact OS and runtime selectors it accepts in this schema.
  "customDatasources": {
    "readthedocs-os": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/readthedocs/readthedocs.org/main/readthedocs/rtd_tests/fixtures/spec/v2/schema.json",
      "transformTemplates": [
        "($versions := properties.build.properties.os.enum[$match($, /^ubuntu-[0-9]+\\.[0-9]+$/)]; {\"releases\": $map($versions, function($version) { {\"version\": $substringAfter($version, \"ubuntu-\")} }), \"sourceUrl\": \"https://github.com/readthedocs/readthedocs.org\", \"homepage\": \"https://docs.readthedocs.com/platform/stable/config-file/v2.html\"})",
      ],
    },
    "readthedocs-tools": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/readthedocs/readthedocs.org/main/readthedocs/rtd_tests/fixtures/spec/v2/schema.json",
      "transformTemplates": [
        "($versions := $lookup(properties.build.properties.tools.properties, \"{{{packageName}}}\").enum; $numeric := \"{{{packageName}}}\" = \"nodejs\" ? $versions[$match($, /^[0-9]+$/)] : $versions[$match($, /^[0-9]+\\.[0-9]+$/)]; {\"releases\": $map($numeric, function($version) { {\"version\": $version} }), \"sourceUrl\": \"https://github.com/readthedocs/readthedocs.org\", \"homepage\": \"https://docs.readthedocs.com/platform/stable/config-file/v2.html\"})",
      ],
    },
  },
  "customManagers": [
    // Numeric runtime versions selected by Read the Docs.
    {
      "customType": "regex",
      "description": "Update Read the Docs Python tool versions",
      "managerFilePatterns": [
        "/(^|/)\\.readthedocs\\.ya?ml$/",
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]+python:[ \\t]*[\"']?(?<currentValue>\\d+\\.\\d+)[\"']?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$)",
      ],
      "datasourceTemplate": "custom.readthedocs-tools",
      "depNameTemplate": "python",
      "packageNameTemplate": "python",
      "versioningTemplate": "semver-coerced",
    },
    {
      "customType": "regex",
      "description": "Update Read the Docs Node.js tool versions",
      "managerFilePatterns": [
        "/(^|/)\\.readthedocs\\.ya?ml$/",
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]+nodejs:[ \\t]*[\"']?(?<currentValue>\\d+(?:\\.\\d+)*)[\"']?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$)",
      ],
      "datasourceTemplate": "custom.readthedocs-tools",
      "depNameTemplate": "node",
      "packageNameTemplate": "nodejs",
      "versioningTemplate": "semver-coerced",
    },
    {
      "customType": "regex",
      "description": "Update Read the Docs Rust tool versions",
      "managerFilePatterns": [
        "/(^|/)\\.readthedocs\\.ya?ml$/",
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]+rust:[ \\t]*[\"']?(?<currentValue>\\d+(?:\\.\\d+)*)[\"']?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$)",
      ],
      "datasourceTemplate": "custom.readthedocs-tools",
      "depNameTemplate": "rust",
      "packageNameTemplate": "rust",
      "versioningTemplate": "semver-coerced",
    },
    {
      "customType": "regex",
      "description": "Update Read the Docs Go tool versions",
      "managerFilePatterns": [
        "/(^|/)\\.readthedocs\\.ya?ml$/",
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]+golang:[ \\t]*[\"']?(?<currentValue>\\d+(?:\\.\\d+)*)[\"']?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$)",
      ],
      "datasourceTemplate": "custom.readthedocs-tools",
      "depNameTemplate": "go",
      "packageNameTemplate": "golang",
      "versioningTemplate": "semver-coerced",
    },
    {
      "customType": "regex",
      "description": "Update Read the Docs Ruby tool versions",
      "managerFilePatterns": [
        "/(^|/)\\.readthedocs\\.ya?ml$/",
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]+ruby:[ \\t]*[\"']?(?<currentValue>\\d+(?:\\.\\d+)*)[\"']?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$)",
      ],
      "datasourceTemplate": "custom.readthedocs-tools",
      "depNameTemplate": "ruby-version",
      "packageNameTemplate": "ruby",
      "versioningTemplate": "semver-coerced",
    },
    {
      "customType": "regex",
      "description": "Update Read the Docs Ubuntu build images",
      "managerFilePatterns": [
        "/(^|/)\\.readthedocs\\.ya?ml$/",
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]+os:[ \\t]*[\"']?ubuntu-(?<currentValue>\\d{2}\\.04)[\"']?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$)",
      ],
      "datasourceTemplate": "custom.readthedocs-os",
      "packageNameTemplate": "os",
      "depNameTemplate": "readthedocs/ubuntu",
      "versioningTemplate": "loose",
    },
  ],
}
