{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Read the Docs supported runtime selectors and build images",
  // Read the Docs publishes the exact OS and runtime selectors it accepts in this schema.
  "customDatasources": {
    "readthedocs-os": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/readthedocs/readthedocs.org/main/readthedocs/rtd_tests/fixtures/spec/v2/schema.json",
      "transformTemplates": [
        "($versions := properties.build.properties.os.enum[$match($, /^ubuntu-[0-9]+\\.[0-9]+$/)]; {\"releases\": $map($versions, function($version) { {\"version\": $substringAfter($version, \"ubuntu-\")} }), \"sourceUrl\": \"https://github.com/readthedocs/readthedocs.org\", \"homepage\": \"https://docs.readthedocs.com/platform/stable/config-file/v2.html\"})",
      ],
    },
    "readthedocs-tools": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/readthedocs/readthedocs.org/main/readthedocs/rtd_tests/fixtures/spec/v2/schema.json",
      "transformTemplates": [
        "($versions := $lookup(properties.build.properties.tools.properties, \"{{{packageName}}}\").enum; $numeric := \"{{{packageName}}}\" = \"nodejs\" ? $versions[$match($, /^[0-9]+$/)] : $versions[$match($, /^[0-9]+\\.[0-9]+$/)]; {\"releases\": $map($numeric, function($version) { {\"version\": $version} }), \"sourceUrl\": \"https://github.com/readthedocs/readthedocs.org\", \"homepage\": \"https://docs.readthedocs.com/platform/stable/config-file/v2.html\"})",
      ],
    },
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Read the Docs runtimes and Ubuntu build images",
      "managerFilePatterns": [
        "/(^|/)\\.readthedocs\\.ya?ml$/",
      ],
      "matchStrings": [
        // Each key has its own pattern so adjacent pins can match independently.
        "(?:^|\\r?\\n)[ \\t]+(?<packageName>python):[ \\t]*[\"']?(?<currentValue>\\d+\\.\\d+)[\"']?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$)",
        "(?:^|\\r?\\n)[ \\t]+(?<packageName>nodejs):[ \\t]*[\"']?(?<currentValue>\\d+(?:\\.\\d+)*)[\"']?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$)",
        "(?:^|\\r?\\n)[ \\t]+(?<packageName>rust):[ \\t]*[\"']?(?<currentValue>\\d+(?:\\.\\d+)*)[\"']?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$)",
        "(?:^|\\r?\\n)[ \\t]+(?<packageName>golang):[ \\t]*[\"']?(?<currentValue>\\d+(?:\\.\\d+)*)[\"']?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$)",
        "(?:^|\\r?\\n)[ \\t]+(?<packageName>ruby):[ \\t]*[\"']?(?<currentValue>\\d+(?:\\.\\d+)*)[\"']?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$)",
        "(?:^|\\r?\\n)[ \\t]+(?<packageName>os):[ \\t]*[\"']?ubuntu-(?<currentValue>\\d{2}\\.04)[\"']?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$)",
      ],
      "datasourceTemplate": "{{#if (equals packageName 'os')}}custom.readthedocs-os{{else}}custom.readthedocs-tools{{/if}}",
      "depNameTemplate": "{{#if (equals packageName 'os')}}readthedocs/ubuntu{{else if (equals packageName 'nodejs')}}node{{else if (equals packageName 'golang')}}go{{else if (equals packageName 'ruby')}}ruby-version{{else}}{{{packageName}}}{{/if}}",
      "versioningTemplate": "{{#if (equals packageName 'os')}}loose{{else}}semver-coerced{{/if}}",
    },
  ],
}
