{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Annotated CPM package lock dependencies",
  "customManagers": [
    {
      "description": "CPM package lock version, tag, and commit pins",
      "customType": "regex",
      "managerFilePatterns": ["/(^|\/)package-lock.cmake$/"],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        // Read the full repository URL and, for GitHub, its owner/repo.
        "# renovate:[^\\r\\n]*(?:\\s*\\r?\\n[ \\t]*#[^\\r\\n]*)*\\s+set\\([A-Za-z0-9_]+_(?:VERSION|TAG|COMMIT)\\s+[^)]+\\)(?:\\s+set\\([A-Za-z0-9_]+_SHA256\\s+[^)]+\\))?(?:\\s+(?:[a-z_][a-z0-9_]*\\([^\\r\\n]*\\)\\s+)*CPMDeclarePackage\\([^)]*?\\r?\\n[ \\t]*GIT_REPOSITORY[ \\t]+\"?(?<gitRepository>https://github\\.com/(?<githubRepository>[A-Za-z0-9-]+/[A-Za-z0-9_.-]+?)(?:\\.git)?/?|[^\"$\\s()]+)\"?(?:[ \\t\\r\\n)]|$))?",
        // Match the metadata and pin without including the package declaration in replacements.
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+) depName=(?<annotatedName>\\S+)(?:(?:[ \\t]+|\\s*\\r?\\n#\\s*)packageName=(?<packageName>\\S+))?(?:(?:[ \\t]+|\\s*\\r?\\n#\\s*)versioning=(?<versioning>\\S+))?(?:(?:[ \\t]+|\\s*\\r?\\n#\\s*)extractVersion=(?<extractVersion>\\S+))?(?:(?:[ \\t]+|\\s*\\r?\\n#\\s*)registryUrl=(?<registryUrl>\\S+))?\\s+(?:# ref=(?<gitRef>\\S+)\\s+set\\([A-Za-z0-9_]+_COMMIT\\s+\"?[a-fA-F0-9]{40}\"?\\s*\\)|set\\([A-Za-z0-9_]+_(?:VERSION|TAG)\\s+\"?(?<pinnedVersion>[^\"\\s)]+)\"?\\s*\\)(?:\\s+set\\([A-Za-z0-9_]+_SHA256\\s+\"?[a-fA-F0-9]{64}\"?\\s*\\))?)",
        // The preceding match validates the digest length. Capture either digest without changing the replacement span.
        "^[\\s\\S]*?(?:_(?:COMMIT|SHA256)\\s+\"?(?<currentDigest>[a-fA-F0-9]+)\"?\\s*\\))?$",
      ],
      // Skip commit pins without a repository.
      "depNameTemplate": "{{#if (or pinnedVersion packageName gitRepository)}}{{{annotatedName}}}{{/if}}",
      "currentValueTemplate": "{{#if gitRef}}{{{gitRef}}}{{else}}{{{pinnedVersion}}}{{/if}}",
      "packageNameTemplate": "{{#if packageName}}{{{packageName}}}{{else if gitRef}}{{{gitRepository}}}{{else if (and (equals datasource 'github-tags') githubRepository)}}{{{githubRepository}}}{{else}}{{{annotatedName}}}{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{/if}}",
    },
  ],
}
