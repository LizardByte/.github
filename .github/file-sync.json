{
  "version": 1,
  "id": "org-sync",
  "include_archived": false,
  "include_forks": true,
  "include_private": false,
  "include_source": false,
  "rules": [
    {
      "id": "obsolete-files",
      "files": [
        {
          "destination": ".codeql-prebuild-cpp-Linux.sh",
          "mode": "remove"
        },
        {
          "destination": ".codeql-prebuild-cpp-Windows.sh",
          "mode": "remove"
        },
        {
          "destination": ".codeql-prebuild-cpp-macOS.sh",
          "mode": "remove"
        },
        {
          "destination": ".github/label-actions.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/pr_release_template.md",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/_docker.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/auto-create-pr.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/automerge.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/autoupdate.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/autoupdate-labeler.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/ci-docker.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/ci-qodana.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/codeql.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/common-lint.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/cpp-lint.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/dispatcher.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/issues.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/issues-stale.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/pull-requests.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/python-flake8.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/release-notifier.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/top_issues.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/update-changelog.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/update-docs.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/update-flathub-repo.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/update-homebrew-release.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/update-pacman-repo.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/update-winget-release.yml",
          "mode": "remove"
        },
        {
          "destination": ".github/workflows/yaml-lint.yml",
          "mode": "remove"
        },
        {
          "destination": "codecov.yml",
          "mode": "remove"
        },
        {
          "destination": "qodana-dotnet.yaml",
          "mode": "remove"
        },
        {
          "destination": "qodana-js.yaml",
          "mode": "remove"
        },
        {
          "destination": "qodana-python.yaml",
          "mode": "remove"
        }
      ]
    },
    {
      "id": "general",
      "files": [
        {
          "source": ".github/dependabot.yml"
        },
        {
          "source": ".github/semantic.yml"
        },
        {
          "source": ".github/workflows/_codeql.yml"
        },
        {
          "source": ".github/workflows/_common-lint.yml"
        },
        {
          "source": ".github/workflows/_top-issues.yml"
        },
        {
          "source": "renovate.json"
        }
      ]
    },
    {
      "id": "docs",
      "profile": "docs",
      "files": [
        {
          "source": ".github/workflows/_update-docs.yml"
        }
      ]
    },
    {
      "id": "flathub",
      "profile": "flathub",
      "files": [
        {
          "source": ".github/workflows/_update-flathub-repo.yml"
        }
      ]
    },
    {
      "id": "homebrew",
      "profile": "homebrew",
      "files": [
        {
          "source": ".github/workflows/_update-homebrew-repo.yml"
        }
      ]
    },
    {
      "id": "pacman",
      "profile": "pacman",
      "files": [
        {
          "source": ".github/workflows/_update-pacman-repo.yml"
        }
      ]
    },
    {
      "id": "winget",
      "profile": "winget",
      "files": [
        {
          "source": ".github/workflows/_update-winget-repo.yml"
        }
      ]
    },
    {
      "id": "node_ci",
      "profile": "node_ci",
      "files": [
        {
          "source": ".github/workflows/_ci-node.yml"
        }
      ]
    },
    {
      "id": "npm",
      "profile": "npm",
      "files": [
        {
          "source": ".github/workflows/_update-npm.yml"
        }
      ]
    },
    {
      "id": "python_style",
      "profile": "python_style",
      "files": [
        {
          "source": ".flake8"
        }
      ]
    },
    {
      "id": "cpp_style",
      "profile": "cpp_style",
      "files": [
        {
          "source": ".clang-format"
        }
      ]
    },
    {
      "id": "custom_issues",
      "profile": "custom_issues",
      "files": [
        {
          "source": ".github/ISSUE_TEMPLATE/config.yml"
        }
      ]
    },
    {
      "id": "release_notifications",
      "profile": "release_notifications",
      "files": [
        {
          "source": ".github/workflows/_release-notifier.yml"
        },
        {
          "source": ".github/workflows/_update-changelog.yml"
        }
      ]
    },
    {
      "id": "organization-community-health",
      "repository_names": [
        ".github"
      ],
      "files": [
        {
          "source": ".github/FUNDING.yml"
        },
        {
          "source": ".github/ISSUE_TEMPLATE/bug-report.yml"
        },
        {
          "source": ".github/ISSUE_TEMPLATE/config.yml"
        },
        {
          "source": ".github/pull_request_template.md"
        },
        {
          "source": "CODE_OF_CONDUCT.md"
        },
        {
          "source": "CONTRIBUTING.md"
        },
        {
          "source": "SECURITY.md"
        },
        {
          "source": "SUPPORT.md"
        }
      ]
    }
  ]
}
